# OpenAI API key -- used for part identification, region explanations,
# datasheet digestion, the chat agent, and chat-memory embeddings.
# The deterministic layers (netlist parsing, graph, quote verification)
# never touch it.
OPENAI_API_KEY=sk-...

# Admin-only GitHub login -- a gate, not a user-accounts system. Anonymous
# visitors keep full read/chat access; login is required only for actions
# that cost money or mutate shared data (upload, create project, propose/
# confirm board links, generate starter firmware). Register an OAuth App at
# github.com/settings/developers -- homepage and callback URL both point at
# your deployed domain, callback path is /auth/github/callback.
SCHEMANTIC_GITHUB_CLIENT_ID=
SCHEMANTIC_GITHUB_CLIENT_SECRET=
SCHEMANTIC_ADMIN_GITHUB_LOGIN=
# Signs the login cookie -- generate once with `python -c "import secrets; print(secrets.token_hex(32))"`,
# never reuse across environments, changing it logs everyone out.
SCHEMANTIC_SESSION_SECRET=
# Set to 0 only for local http://127.0.0.1 testing of the login gate --
# the live site must keep this at its default (1/unset), or the session
# cookie is sent in the clear.
# SCHEMANTIC_SESSION_HTTPS_ONLY=1
# Independent budget pools (see schemantic/web/app.py::_get_supervisor) --
# public covers chat, admin covers upload/propose-mates/firmware-starter.
# SCHEMANTIC_PUBLIC_BUDGET_USD=5.0
# SCHEMANTIC_ADMIN_BUDGET_USD=5.0

# Optional overrides
# SCHEMANTIC_PDF=path/to/default_board.pdf
# SCHEMANTIC_IDENTITY_MODEL=gpt-4.1-mini
# SCHEMANTIC_EXPLAINER_MODEL=gpt-4.1-mini
# SCHEMANTIC_DIGEST_MODEL=gpt-4.1-mini
# SCHEMANTIC_CHAT_MODEL=gpt-4.1
# SCHEMANTIC_MATE_MODEL=gpt-4.1
# SCHEMANTIC_EMBED_MODEL=text-embedding-3-small
